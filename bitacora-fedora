dentro de ~/bashrc.d/ puse 2 archivos: "bash_extras" y "bash_aliases". Importante notar que los archivos no empiezan con punto ".". Si empezaran con punto tendría que modificar el archivo .bashrc en el bloque que los carga 

dentro de ~/bashrc.d/bash_extras:

	export HISTSIZE=-1
	export HISTFILESIZE=-1
	export PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

	# wrap line Correcto (ajusta perfectamente):
	PS1="\[\e[32m\]\u@\h:\w\$ "

dentro de ~/.bashrc.d/bash_aliases:

	alias la='ls -a'
	alias gitaddcomm='git add . && git commit -m '
	alias bitacora='cd ~/Repos/bitacora-linux && la'
	alias repos='cd ~/Repos && la'

dentro de ~/.nanorc:
	set softwrap


